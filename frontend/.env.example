# ==============================================================================
# Gemini AI Platform — Environment Configuration Template
# ==============================================================================

# Google Gemini API Key
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# NOTE: Kept strictly on the server-side, never exposed to client browsers.
GEMINI_API_KEY=your_gemini_api_key_here

# Default model used for initial chat sessions
DEFAULT_MODEL=gemini-2.5-flash